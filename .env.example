# 복사해서 .env.local 로 저장하세요. (.env*.local 은 git 에 올라가지 않습니다)

# [필수/운영] 세션 토큰 서명 키. 충분히 긴 임의 문자열 (예: openssl rand -base64 48)
# 운영(NODE_ENV=production)에서 없으면 로그인이 동작하지 않습니다. 변경하면 기존 세션은 모두 무효가 됩니다.
JWT_SECRET=

# [초기 관리자] SUPER_ADMIN 계정이 하나도 없을 때만, 서버 시작 시 1회 생성합니다. (기존 계정은 바꾸지 않습니다)
# 생성 후에는 이 값을 지워도 됩니다. 비밀번호는 로그인 후 변경하세요.
ADMIN_INITIAL_PASSWORD=
# ADMIN_LOGIN_ID=admin

# [개발 전용 데모 데이터] 개발 환경(NODE_ENV != production)에서만 동작합니다.
# SEED_DEMO_DATA=1 이면 데모 계정(kim, lee, choi, song, park)과 샘플 고객사/품목/단가를 생성합니다.
# SEED_DEMO_DATA=1
# SEED_DEMO_PASSWORD=
# 로그인 화면의 '빠른 선택' 버튼 (개발 모드에서만 표시). 위 SEED_DEMO_PASSWORD 와 같은 값을 넣으세요.
# NEXT_PUBLIC_DEMO_LOGIN=1
# NEXT_PUBLIC_DEMO_PASSWORD=

# [EGDesk] 보통 EGDesk 가 개발 서버를 띄울 때 자동 주입합니다. 수동 실행 시에만 설정하세요.
NEXT_PUBLIC_EGDESK_API_KEY=
NEXT_PUBLIC_EGDESK_API_URL=http://localhost:8080

# [EGDesk 프로젝트 위치] 아래 중 하나만 지정하면 됩니다. 모두 없으면 EGDesk 프로젝트가
# 1개일 때만 자동 선택하고, 그 외에는 ./storage 를 사용합니다.
NEXT_PUBLIC_EGDESK_PROJECT_ID=
NEXT_PUBLIC_EGDESK_ENV=development
# EGDESK_PROJECT_DIR=

# [개별 경로 직접 지정 - 서버/Docker 배포용]
# EGDESK_USER_DATA_DB_PATH=/data/user_data.db
# EGDESK_STORAGE_DIR=/data/storage
